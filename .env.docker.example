# ==============================================================================
# REWOIX Docker Environment Configuration Template
# Copy this file to .env before starting Docker Compose:
#   cp .env.docker.example .env
# ==============================================================================

# Application Environment (production / development)
APP_ENV=production
DEBUG=False
SECRET_KEY=rewoix_super_secret_jwt_hmac_sha256_production_key_987654321

# Host Exposed Ports for Production & Dev
HTTP_PORT=80
HTTPS_PORT=443
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# PostgreSQL Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=rewoix_db

# Frontend Public API URL (accessible by user browser on host machine)
NEXT_PUBLIC_API_URL=/api/v1

# Payment Gateway (Razorpay - Replace with your live or test keys)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_test_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret

# Object Storage Configuration (local / azure / s3)
STORAGE_PROVIDER=local
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=rewoix-media
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Transactional Email & Security Alert Notifications (SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_api_key_here
EMAILS_FROM_EMAIL=security@rewoix.com
EMAILS_FROM_NAME=REWOIX Security

# Platform Financial Splits
DEFAULT_PLATFORM_COMMISSION_PERCENT=30.0
DEFAULT_TEACHER_SHARE_PERCENT=70.0
DEFAULT_CURRENCY=INR
