# Application & Security Configuration
APP_ENV=development
DEBUG=True
SECRET_KEY=change_me_to_a_secure_random_production_secret_key_12345
API_V1_STR=/api/v1

# Database Configuration (SQLite by default, or PostgreSQL for Docker/Production)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/rewoix_db
SYNC_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/rewoix_db

# Redis Cache & Worker Broker
REDIS_URL=redis://localhost:6379/0

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Object Storage (Azure Blob / AWS S3 / Local)
STORAGE_PROVIDER=local  # local, azure, s3
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=rewoix-media
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
LOCAL_STORAGE_DIR=./media

# Financial Ledger Commission Defaults
DEFAULT_PLATFORM_COMMISSION_PERCENT=30.0
DEFAULT_TEACHER_SHARE_PERCENT=70.0
DEFAULT_CURRENCY=INR

# AI Provider Configuration
AI_PROVIDER=mock  # mock, openai, gemini
AI_API_KEY=

# SMTP Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@rewoix.com
